type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type SubmitResult = 
 variant {
   err: SubmitError;
   ok: Score;
 };
type SubmitError = 
 variant {
   anonymous;
   nameInvalid;
   notHighEnough;
   zeroScore;
 };
type Score = 
 record {
   displayName: text;
   owner: principal;
   points: nat;
   recordedAt: int;
   stage: nat;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result) query;
  getCallerUserRole: () -> (UserRole) query;
  getLeaderboard: () -> (vec Score) query;
  getMyScore: () -> (opt Score) query;
  isCallerAdmin: () -> (bool) query;
  schema: () -> (text) query;
  submitScore: (displayName: text, points: nat, stage: nat) -> (SubmitResult);
}
